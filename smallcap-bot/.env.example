# BotFather'dan aldığınız token (zorunlu)
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Gönderi biçimi: html (önerilen) | markdownv2 | plain
TELEGRAM_PARSE_MODE=html

# Boş bırakılırsa bot herkese açıktır. Kısıtlamak için sohbet ID'lerini
# virgülle ayırarak yazın (grup ID'leri negatif olabilir).
# Kanala gönderim kullanacaksanız bu alan ZORUNLUDUR.
TELEGRAM_ALLOWED_CHAT_IDS=

# Gönderilerin atılacağı kanal/grup. Kanal ID'si -100 ile başlar; herkese
# açık kanallarda @kanaladi de yazılabilir. Boşsa kanala gönderim kapalıdır.
# Bot kanalda YÖNETİCİ olmalıdır.
TELEGRAM_TARGET_CHAT_ID=

# Canlı veri (isteğe bağlı). Kapatmak için AUTO_FETCH=0 yapın.
AUTO_FETCH=1
FINNHUB_API_KEY=
REQUEST_TIMEOUT=10

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Kendi Bot API sunucunuzu çalıştırıyorsanız (self-hosted veya test).
# Boş bırakılırsa resmî https://api.telegram.org/bot kullanılır.
TELEGRAM_API_BASE_URL=
